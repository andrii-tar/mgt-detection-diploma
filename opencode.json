{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "local-git": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "mcp_server_git",
        "--repository",
        "."
      ],
      "enabled": true
    },
    "jupyter": {
      "type": "local",
      "command": [
        "uvx",
        "jupyter-mcp-server"
      ],
      "enabled": true,
      "env": {
        "JUPYTER_URL": "http://localhost:8888",
        "JUPYTER_TOKEN": "{env:JUPYTER_TOKEN}"
      }
    }

  },
  "permission": {
    "external_directory": {
      ".": "allow",
      "D:\\Projects\\master_diploma\\text-detection-data": "allow"
    },
    "*": "ask",
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "question": "allow",

    "local-git_git_status": "allow",
    "local-git_git_diff": "allow",
    "local-git_git_diff_unstaged": "allow",
    "local-git_git_diff_staged": "allow",
    "local-git_git_log": "allow",
    "local-git_git_show": "allow",
    "local-git_git_branch": "allow",

    "local-git_git_add": "ask",
    "local-git_git_commit": "ask",
    "local-git_git_checkout": "ask",
    "local-git_git_create_branch": "ask",
    "local-git_git_reset": "ask",

    "node --check**": "allow",

    "doom_loop": "ask",
    "delete": "ask",
    "skill": {
          "*": "allow"
        }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
