{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "local-git": {
      "type": "local",
      "command": [
        "python",
        "-m",
        "mcp_server_git",
        "--repository",
        "."
      ],
      "enabled": true
    }
  },
  "permission": {
    "external_directory": {
      ".": "allow",
      "D:\\Projects\\master_diploma\\text-detection-data": "allow"
    },
    "*": "ask",
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "question": "allow",

    "node --check**": "allow",

    "doom_loop": "ask",
    "delete": "ask"
  }
}
