TEXT_DETECTION_DATA=/workspace/text-detection/data

# Prefer already-downloaded Hugging Face files and avoid Hub requests.
# Set to 0 or remove these if the server should download missing models.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

HF_TOKEN=hf_your_token_here
HUGGING_FACE_HUB_TOKEN=hf_your_token_here
